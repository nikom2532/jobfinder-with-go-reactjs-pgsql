version: '3.8'

services:
  web:
    build:
      context: .
      dockerfile: Dockerfile
      target: development # ระบุ stage ที่จะ build (development หรือ production)
    container_name: 021-my-react-app-dev
    ports:
      - "5173:5173" # Map port จาก host machine ไปยัง container
    volumes:
      - .:/app          # Mount โค้ดปัจจุบันเข้าไปใน container สำหรับ hot reloading
      - /app/node_modules # ไม่ mount node_modules จาก host (ใช้ที่ติดตั้งใน container)
    environment:
      - NODE_ENV=development
      - CHOKIDAR_USEPOLLING=true # อีกทางเลือกหนึ่งสำหรับ hot reload ใน Docker
    stdin_open: true # Keep stdin open for interaction
    tty: true        # Allocate a pseudo-TTY